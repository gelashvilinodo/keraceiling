---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="გვერდი ვერ მოიძებნა">
  <section class="nf container">
    <p class="nf__code">404</p>
    <h1 class="nf__title">გვერდი ვერ მოიძებნა</h1>
    <a class="btn btn--primary" href="/">მთავარზე დაბრუნება</a>
  </section>
</BaseLayout>

<style>
  .nf { display: grid; gap: var(--sp-5); justify-items: start; padding-block: var(--sp-8); min-height: 60vh; align-content: center; }
  .nf__code { font-size: var(--fs-xs); letter-spacing: 0.1em; color: var(--c-muted); }
  .nf__title { font-size: var(--fs-3xl); font-weight: 300; }
</style>
