---
import { site } from '../data/site';

interface Props {
  /**
   * 'auto'  — ღია ფონზე ღია ვერსია, ინტროს ჩაბნელებისას (html.lights-off) კი მუქი; გადასვლა გლუვია (ჰედერი)
   * 'light' — მხოლოდ ღია ფონის ვერსია
   * 'dark'  — მხოლოდ მუქი ფონის ვერსია (ფუტერი, მუქი სექციები)
   */
  variant?: 'auto' | 'light' | 'dark';
}
const { variant = 'auto' } = Astro.props;
const LIGHT = '/images/kera-logo-premium.svg';
const DARK = '/images/kera-logo-premium-dark.svg';
---

<a class="logo" href="/" aria-label={`${site.name} ${site.nameSuffix} — მთავარი`}>
  <span class:list={['logo__mark', `logo__mark--${variant}`]} aria-hidden="true">
    {variant !== 'dark' && (
      <img class="logo__img logo__img--light" src={LIGHT} alt="" width="416" height="246" decoding="async" />
    )}
    {variant !== 'light' && (
      <img class="logo__img logo__img--dark" src={DARK} alt="" width="416" height="246" decoding="async" />
    )}
  </span>
  <span class="logo__text">{site.name}<span class="logo__suffix">{site.nameSuffix}</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-weight: 600;
    letter-spacing: 0.18em;
    font-size: var(--fs-sm);
  }
  .logo__mark {
    display: grid;
    height: 34px;
    aspect-ratio: 416 / 246;
  }
  .logo__img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* auto: ორივე ვერსია ერთმანეთზეა, ჩანს ის, რომელიც ფონს შეესაბამება */
  .logo__mark--auto .logo__img--dark { opacity: 0; }
  :global(html.lights-off:not(.site-lit)) .logo__mark--auto .logo__img--dark { opacity: 1; }
  :global(html.lights-off:not(.site-lit)) .logo__mark--auto .logo__img--light { opacity: 0; }
  :global(html.lights-off) .logo__mark--auto .logo__img {
    transition: opacity calc(1s * var(--intro-speed)) ease;
  }

  .logo__suffix {
    font-weight: 300;
    margin-left: 0.4em;
    color: var(--c-muted);
  }
</style>
