---
import SectionHeading from '../SectionHeading.astro';
---

<section class="section" id="before-after">
  <div class="container">
    <SectionHeading index="03" label="შედეგი" title="ადრე და შემდეგ" lead="გადაწიეთ სახელური შედარებისთვის." />

    <div class="ba" data-ba style="--pos: 50%">
      <img
        class="ba__layer ba__before"
        src="/images/before-after/before-1520.jpg"
        srcset="/images/before-after/before-960.jpg 960w, /images/before-after/before-1520.jpg 1520w"
        sizes="(min-width: 1416px) 1320px, (min-width: 1024px) calc(100vw - 96px), (min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)"
        width="1520"
        height="950"
        alt="ოთახი ჭერის მონტაჟამდე: შიშველი ბეტონის ჭერი"
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <img
        class="ba__layer ba__after"
        src="/images/before-after/after-1520.jpg"
        srcset="/images/before-after/after-960.jpg 960w, /images/before-after/after-1520.jpg 1520w"
        sizes="(min-width: 1416px) 1320px, (min-width: 1024px) calc(100vw - 96px), (min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)"
        width="1520"
        height="950"
        alt="იგივე ოთახი გასაჭიმი ჭერით და ჩაშენებული LED განათებით"
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <div class="ba__handle" aria-hidden="true"></div>
      <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="შედარების სლაიდერი" data-ba-range />
      <span class="ba__tag ba__tag--l">ადრე</span>
      <span class="ba__tag ba__tag--r">შემდეგ</span>
    </div>
  </div>
</section>

<style>
  .ba { position: relative; overflow: hidden; user-select: none; touch-action: pan-y; background: #e6e6e3; }
  .ba__layer {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .ba__after {
    position: absolute;
    inset: 0;
    height: 100%;
    clip-path: inset(0 0 0 var(--pos));
  }
  .ba__handle {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--pos);
    width: 1px;
    background: var(--c-ink);
    pointer-events: none;
  }
  .ba__handle::after {
    content: '‹ ›';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: var(--fs-sm);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }
  .ba__tag {
    position: absolute;
    top: var(--sp-3);
    padding: var(--sp-1) var(--sp-2);
    font-size: var(--fs-xs);
    background: var(--c-bg);
    pointer-events: none;
  }
  .ba__tag--l { left: var(--sp-3); }
  .ba__tag--r { right: var(--sp-3); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('[data-ba-range]');
    range?.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });
</script>
