---
// დამკვეთების შეფასებები — იტვირთება /api/reviews-დან (Cloudflare D1).
// ჩანს მხოლოდ დადასტურებული შეფასებები. სანამ ერთიც არ არის, სექცია დამალულია.
// შეფასებები გროვდება დამალული გვერდიდან: /review (საიტზე მასზე ბმული არ არის).
import SectionHeading from '../SectionHeading.astro';
import SwipeBar from '../SwipeBar.astro';
---

<section class="section" id="reviews" hidden data-reviews>
  <div class="container">
    <SectionHeading index="08" label="შეფასებები" title="რას ამბობენ დამკვეთები" />

    <p class="summary" data-summary hidden>
      <span class="summary__stars" aria-hidden="true">★</span>
      <span class="summary__avg" data-avg></span>
      <span class="summary__count muted" data-count></span>
    </p>

    <ul role="list" class="reviews swipe" data-list aria-label="შეფასებები — გადაფურცლეთ გვერდულად"></ul>
    <SwipeBar />

    <template data-tpl>
      <li class="review">
        <p class="review__stars" data-stars></p>
        <blockquote class="review__text" data-text></blockquote>
        <div class="review__foot">
          <p class="review__name" data-name></p>
          <p class="review__meta muted" data-meta></p>
        </div>
      </li>
    </template>
  </div>
</section>

<style>
  .summary { display: flex; align-items: baseline; gap: var(--sp-2); margin: calc(var(--sp-5) * -1) 0 var(--sp-6); }
  .summary[hidden] { display: none; }
  .summary__stars { color: #c9a86f; font-size: var(--fs-xl); }
  .summary__avg { font-size: var(--fs-xl); font-weight: 400; font-variant-numeric: tabular-nums; }
  .summary__count { font-size: var(--fs-sm); }

  .reviews { display: grid; gap: 1px; background: var(--c-line); border: 1px solid var(--c-line); }
  .review { display: grid; gap: var(--sp-4); grid-template-rows: auto 1fr auto; padding: var(--sp-5); background: var(--c-bg); }
  .review__stars { letter-spacing: 0.15em; font-size: var(--fs-sm); color: #a5874f; }
  .review__text { font-size: var(--fs-lg); font-weight: 300; white-space: pre-line; overflow-wrap: anywhere; }
  .review__foot { display: grid; gap: 2px; }
  .review__name { font-size: var(--fs-sm); font-weight: 500; }
  .review__meta { font-size: var(--fs-xs); }

  /* ტელეფონზე — გვერდულად სქროლვადი გალერეა (.swipe, global.css) */
  @media (max-width: 639px) {
    .reviews { background: none; border: 0; }
    .review { border: 1px solid var(--c-line); }
  }
  @media (min-width: 640px) { .reviews { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .reviews { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  type Review = { name: string; rating: number; text: string; room: string | null; district: string | null; date: string };
  type Payload = { count: number; average: number; reviews: Review[] };

  const section = document.querySelector<HTMLElement>('[data-reviews]');
  const list = section?.querySelector<HTMLElement>('[data-list]');
  const tpl = section?.querySelector<HTMLTemplateElement>('[data-tpl]');

  const plural = (n: number) => `${n} შეფასება`;
  // თვეები ხელითაა — ზოგ ბრაუზერს/მოწყობილობას ქართული თვეების სახელები არ აქვს
  const MONTHS = ['იანვარი', 'თებერვალი', 'მარტი', 'აპრილი', 'მაისი', 'ივნისი', 'ივლისი', 'აგვისტო', 'სექტემბერი', 'ოქტომბერი', 'ნოემბერი', 'დეკემბერი'];
  const fmtDate = (iso: string) => {
    const [y, m] = iso.split('-').map(Number);
    return y && m ? `${MONTHS[m - 1]} ${y}` : '';
  };

  async function load() {
    if (!section || !list || !tpl) return;
    let data: Payload;
    try {
      const res = await fetch('/api/reviews', { headers: { accept: 'application/json' } });
      if (!res.ok) return; // მაგ. ლოკალურ `astro dev`-ში API არ არის — სექცია უბრალოდ დამალული რჩება
      data = await res.json();
    } catch {
      return;
    }
    if (!data?.reviews?.length) return;

    for (const r of data.reviews) {
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const rating = Math.max(1, Math.min(5, Math.round(r.rating)));
      const stars = node.querySelector<HTMLElement>('[data-stars]')!;
      stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      stars.setAttribute('aria-label', `შეფასება: ${rating} / 5`);
      // textContent — მომხმარებლის ტექსტი HTML-ად არასდროს ჩაისმება
      node.querySelector('[data-text]')!.textContent = `„${r.text}“`;
      node.querySelector('[data-name]')!.textContent = r.name;
      const date = r.date ? fmtDate(r.date) : '';
      node.querySelector('[data-meta]')!.textContent = [r.room, r.district, date].filter(Boolean).join(' · ');
      list.appendChild(node);
    }

    const summary = section.querySelector<HTMLElement>('[data-summary]');
    if (summary && data.count >= 3) {
      summary.querySelector('[data-avg]')!.textContent = data.average.toFixed(1).replace('.', ',');
      summary.querySelector('[data-count]')!.textContent = `· ${plural(data.count)}`;
      summary.hidden = false;
    }

    section.hidden = false;
    // სექციების ნომრები თავიდან დაითვალოს (SectionHeading)
    document.dispatchEvent(new Event('sections:change'));
  }

  load();
</script>
